{
  "metadata": {
    "policyVersion": "1.0.0",
    "lastUpdated": "2025-01-01",
    "owner": "Enterprise Security & Compliance Team",
    "description": "BobGuard AI Provenance Gateway — Enterprise governance ruleset for AI-generated code commits."
  },
  "governance_rules": {
    "security_framework": "OWASP_Top_10",
    "banned_vulnerabilities": [
      "NoSQL Injection",
      "SQL Injection",
      "Hardcoded Secrets",
      "Broken Authentication",
      "Open Redirect",
      "Cross-Site Scripting",
      "Insecure Direct Object Reference",
      "Security Misconfiguration"
    ],
    "vulnerability_patterns": {
      "nosql_injection": [
        "req\\.body\\.[a-zA-Z_]+\\s*\\$",
        "\\$where\\s*:",
        "\\$gt\\s*:\\s*['\"]",
        "\\$ne\\s*:\\s*(null|undefined|0|['\"])"
      ],
      "hardcoded_secrets": [
        "password\\s*[=:]\\s*['\"][^'\"]{4,}['\"]",
        "secret\\s*[=:]\\s*['\"][^'\"]{4,}['\"]",
        "api_?key\\s*[=:]\\s*['\"][^'\"]{4,}['\"]",
        "token\\s*[=:]\\s*['\"][^'\"]{8,}['\"]",
        "private_?key\\s*[=:]\\s*['\"][^'\"]{4,}['\"]",
        "cookieSecret\\s*:\\s*['\"][^'\"]{4,}['\"]",
        "cryptoKey\\s*:\\s*['\"][^'\"]{4,}['\"]"
      ],
      "open_redirect": [
        "res\\.redirect\\s*\\(\\s*req\\.(query|body|params)\\.",
        "location\\.href\\s*=\\s*req\\.(query|body|params)\\."
      ],
      "broken_auth": [
        "compareSync\\s*\\(\\s*password\\s*,\\s*user\\.password\\s*\\)",
        "password\\s*===\\s*req\\.",
        "md5\\s*\\("
      ],
      "eval_injection": [
        "eval\\s*\\(",
        "new\\s+Function\\s*\\(",
        "setTimeout\\s*\\(\\s*['\"]"
      ],
      "plaintext_password_store": [
        "password\\s*,\\s*\\/\\/",
        "password\\s*:\\s*password(?!\\s*\\.hash|\\s*\\.bcrypt|\\s*hashSync|\\s*hash\\s*\\()",
        "user\\.password\\s*=\\s*(?!bcrypt|hash|encrypt)"
      ],
      "plaintext_password_compare": [
        "fromDB\\s*===\\s*fromUser",
        "fromDB\\s*==\\s*fromUser",
        "password\\s*===\\s*[a-zA-Z_][a-zA-Z0-9_.]*\\.password",
        "password\\s*==\\s*[a-zA-Z_][a-zA-Z0-9_.]*\\.password"
      ],
      "xss_autoescape_disabled": [
        "autoescape\\s*:\\s*false",
        "sanitize\\s*:\\s*false",
        "escapeHTML\\s*:\\s*false"
      ],
      "xss_unescaped_write": [
        "res\\.write\\s*\\(\\s*body\\s*\\)",
        "res\\.send\\s*\\(\\s*body\\s*\\)",
        "res\\.end\\s*\\(\\s*body\\s*\\)"
      ],
      "idor": [
        "req\\.params\\.[a-zA-Z]*[Uu]ser[Ii]d",
        "req\\.params\\.[a-zA-Z]*[Aa]ccount[Ii]d",
        "\\{\\s*userId\\s*\\}\\s*=\\s*req\\.params",
        "\\{\\s*userId[^}]*\\}\\s*=\\s*req\\.body"
      ],
      "ssrf": [
        "needle\\.get\\s*\\(\\s*[a-zA-Z_][a-zA-Z0-9_.]*\\s*,",
        "require\\s*\\(['\"]request['\"]\\).*req\\.(query|body|params)\\.",
        "http\\.get\\s*\\(.*req\\.(query|body|params)\\."
      ],
      "redos": [
        "\\([^)]+\\+\\)\\+",
        "\\([^)]+\\*\\)\\*",
        "\\([^)]+\\+\\)\\*"
      ],
      "plaintext_pii": [
        "user\\.ssn\\s*=\\s*ssn",
        "user\\.dob\\s*=\\s*dob",
        "\\.ssn\\s*=\\s*(?!encrypt|hash|cipher)",
        "\\.dob\\s*=\\s*(?!encrypt|hash|cipher)"
      ],
      "session_fixation": [
        "req\\.session\\.[a-zA-Z]+\\s*=\\s*[a-zA-Z_][a-zA-Z0-9_.]*\\._id"
      ],
      "http_insecure": [
        "http\\.createServer\\s*\\("
      ]
    }
  },
  "compliance_rules": {
    "banned_licenses": [
      "GPL-2.0",
      "GPL-2.0-only",
      "GPL-2.0-or-later",
      "GPL-3.0",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "AGPL-3.0",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "SSPL-1.0",
      "BUSL-1.1"
    ],
    "license_patterns": [
      "SPDX-License-Identifier:\\s*(GPL|AGPL|SSPL|BUSL)",
      "@license\\s+(GPL|AGPL)",
      "GNU General Public License",
      "GNU Affero General Public License"
    ],
    "block_on_hallucinated_deps": true,
    "package_registries": {
      "npm": "https://registry.npmjs.org",
      "pypi": "https://pypi.org/pypi"
    },
    "allowed_licenses": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "0BSD",
      "Unlicense"
    ]
  },
  "enforcement": {
    "block_commit_on_failure": true,
    "attempt_auto_remediation": true,
    "fail_open_on_gateway_timeout": true,
    "gateway_timeout_ms": 15000,
    "notify_channels": ["console"],
    "audit_all_commits": true
  },
  "provenance": {
    "hash_algorithm": "sha256",
    "hash_scope": "full_audit_payload",
    "track_ai_ratio": true,
    "ai_author_tag": "IBM Bob 2.0"
  }
}
