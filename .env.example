# ============================================================
# BobGuard — AI Provenance Gateway
# Root Environment Variables Reference
# ============================================================
# This file documents ALL environment variables used across
# the project. Copy the relevant section to the appropriate
# sub-directory .env file (see instructions below).
#
# DO NOT place real secrets in this file.
# ============================================================


# ------------------------------------------------------------
# BACKEND  ->  copy to: mern-auditor-platform/backend/.env
# ------------------------------------------------------------

# Express server port — must match GATEWAY_PORT in the pre-commit hook
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bobguard

# Path to the enterprise governance policy file.
# Relative paths are resolved from mern-auditor-platform/backend/
POLICY_PATH=../../mock-enterprise-target/.ai-policy.json

# Comma-separated list of allowed CORS origins (Vite dev server)
CORS_ORIGIN=http://localhost:5173


# ------------------------------------------------------------
# FRONTEND  ->  copy to: mern-auditor-platform/frontend/.env.local
# Only required when deploying to a non-localhost backend.
# Falls back to http://localhost:5000/api/audit when absent.
# ------------------------------------------------------------

# Full URL of the BobGuard backend API (must be prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api/audit