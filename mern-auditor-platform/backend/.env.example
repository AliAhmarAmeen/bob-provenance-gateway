# BobGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express gateway listens on.
# Must match GATEWAY_PORT in the pre-commit hook (default: 5000).
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/bobguard

# ── Policy ────────────────────────────────────────────────────────────────────
# Absolute or repo-root-relative path to the enterprise policy file.
# Defaults to ../../mock-enterprise-target/.ai-policy.json when not set.
POLICY_PATH=../../mock-enterprise-target/.ai-policy.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin(s) allowed to call the API (comma-separated for multiple).
# Set to the Vite dev server origin during development.
CORS_ORIGIN=http://localhost:5173
